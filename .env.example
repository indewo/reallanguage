# RealLanguage production API. Copy values into the deployment secret manager;
# never commit a populated .env file.
NODE_ENV=production
DATABASE_URL=postgres://REPLACE_WITH_PRODUCTION_DATABASE
DATABASE_SSL=true
DATABASE_APPLICATION_NAME=reallanguage-api
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
ADMIN_ALLOWED_ORIGINS=https://admin.reallanguage.me
ADMIN_EMAIL=indewo@outlook.com
ADMIN_ALLOW_LOOPBACK_BOOTSTRAP=false

USER_AGREEMENT_FILE=/run/secrets/reallanguage/user-agreement.txt
PRIVACY_POLICY_FILE=/run/secrets/reallanguage/privacy-policy.txt

# Each BASE64 value must decode to exactly 32 bytes and every key must be distinct.
REGISTRATION_ENCRYPTION_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
ACCOUNT_ENCRYPTION_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
EMAIL_INDEX_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
VERIFICATION_DIGEST_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
SESSION_DIGEST_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
DEVICE_DIGEST_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
SAFETY_PAYLOAD_ENCRYPTION_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
PAYMENT_WEBHOOK_SECRET_BASE64=REPLACE_IN_SECRET_MANAGER
ADMIN_ENCRYPTION_KEY_BASE64=REPLACE_IN_SECRET_MANAGER
ADMIN_DIGEST_KEY_BASE64=REPLACE_IN_SECRET_MANAGER

DUMMY_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
PASSWORD_BLOCKLIST=REPLACE_WITH_DEPLOYMENT_BLOCKLIST
VERIFICATION_EMAIL_COOLDOWN_SECONDS=60

SAFETY_PROVIDER_URL=https://REPLACE_WITH_SAFETY_PROVIDER
SAFETY_PROVIDER_API_KEY=REPLACE_IN_SECRET_MANAGER
SAFETY_PAYLOAD_TTL_SECONDS=300
CONTENT_FORMATION_PROVIDER_URL=https://REPLACE_WITH_METERED_AI_GATEWAY
CONTENT_FORMATION_PROVIDER_API_KEY=REPLACE_IN_SECRET_MANAGER

PAYMENT_PROVIDER_URL=https://REPLACE_WITH_PAYMENT_ORDER_PROVIDER
PAYMENT_REFUND_PROVIDER_URL=https://REPLACE_WITH_PAYMENT_REFUND_PROVIDER
PAYMENT_STATUS_PROVIDER_URL=https://REPLACE_WITH_PAYMENT_STATUS_PROVIDER
PAYMENT_PROVIDER_API_KEY=REPLACE_IN_SECRET_MANAGER
REFUND_BATCH_SIZE=25
REFUND_RECONCILIATION_INTERVAL_MS=60000
